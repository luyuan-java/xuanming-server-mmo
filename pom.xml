<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.game</groupId>
    <artifactId>xuanming-server-mmo</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>xuanming-server-mmo (Java)</name>
    <description>MMORPG 服务器 Java 版，与 mmorpg（C++/Go 版）双版本并行，对账见 PARITY.md</description>

    <modules>
        <module>xm-proto</module>
        <module>xm-table-codegen</module>
        <module>xm-table</module>
        <module>xm-net</module>
        <module>xm-common</module>
        <module>xm-battle-engine</module>
        <module>xm-pbmysql</module>
        <module>xm-api</module>
        <module>xm-discovery</module>
        <module>xm-player-store</module>
        <module>xm-gateway-store</module>
        <module>xm-audit</module>
        <module>xm-scene-manager</module>
        <module>xm-login</module>
        <module>xm-friend</module>
        <module>xm-chat</module>
        <module>xm-team</module>
        <module>xm-guild</module>
        <module>xm-trade</module>
        <module>xm-match</module>
        <module>xm-scene</module>
        <module>xm-battle</module>
        <module>xm-gate</module>
        <module>xm-gateway</module>
        <module>xm-data</module>
        <module>xm-robot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 选型与版本理由见 docs/design/tech-stack.md。protobuf 与 mmorpg 的 protoc 35.1 同代，生成代码对运行时有强校验。 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <dubbo.version>3.3.6</dubbo.version>
        <protobuf.version>4.35.1</protobuf.version>
        <guava.version>33.4.0-jre</guava.version>
        <redisson.version>3.50.0</redisson.version>
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
        <druid.version>1.2.28</druid.version>
        <!-- Argon2id（生产口令认证）：JDK 没有 Argon2，Java 生态没有 ≥2 万 star 的同类库，取事实标准 BouncyCastle（见 tech-stack.md） -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <protobuf-maven-plugin.version>5.1.10</protobuf-maven-plugin.version>
        <!-- 默认按版本从 Maven 仓库取 protoc；网络受限的机器可用 -Dprotoc.spec=file:///.../protoc.exe 指向同版本的本地 protoc -->
        <protoc.spec>${protobuf.version}</protoc.spec>
        <!-- 构建戳（见下面 spring-boot-maven-plugin 的 build-info）：CI / 镜像构建用 -Dxm.build.commit=<40 位 sha>
             -Dxm.build.contract=<contract/SOURCE.properties 的 mmorpg.commit> 覆盖；本机构建取缺省（命令行 -D 优先于 pom 属性） -->
        <xm.build.commit>unknown</xm.build.commit>
        <xm.build.contract>unknown</xm.build.contract>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-proto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-table-codegen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-table</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-net</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-pbmysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-discovery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-player-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-gateway-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.game</groupId>
                <artifactId>xm-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <!-- 测试进程的总时限：某条用例无限等待（例如对永不完成的 future 调 join()）时，让构建在 30 分钟后失败，
                         而不是把 surefire 进程永远挂在那里（2026-10-06 本机实例：一个挂死的 fork 占着模块 target 一个多小时）。
                         最慢的模块（xm-scene / xm-data 带真依赖）本机约 3 分钟，CI 上按几倍估仍远小于此值。
                         版本钉在此前由 Maven 缺省绑定解析出来的 3.2.5，行为不变；各模块自己的 configuration 与这里合并。 -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.github.ascopes</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                    <configuration>
                        <protoc>${protoc.spec}</protoc>
                        <javaEnabled>true</javaEnabled>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- 构建信息（docs/porting/deploy-ci-spec.md §5.1）：写 META-INF/build-info.properties，经 /actuator/info 暴露。
                             build.version = project.version（不覆盖：发布版本号方案归 7.6），另加 40 位的 commit 与契约来源 contract。
                             声明了本插件的进程模块（含 xm-robot）都会把这个 execution 与自己的 repackage 合并，模块 pom 不用动；
                             库模块没有声明本插件，不受影响。不用 git-commit-id 插件（star 不够），commit 由 CI / 镜像构建用 -D 传入。 -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                            <configuration>
                                <additionalProperties>
                                    <commit>${xm.build.commit}</commit>
                                    <contract>${xm.build.contract}</contract>
                                </additionalProperties>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
