<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xm-table</artifactId>
    <name>xm-table</name>
    <description>
        配置表与 tip 码。src/main/proto 是 mmorpg 导表器的权威 schema 与 tip / operator 枚举（tools/ContractSync.java 同步，
        派生物，不许手改）；com.game.table.ConfigTables 与各表的 Rows 视图由 xm-table-codegen 在编译期按 schema 生成；
        com.game.table.load 是它们共用的手写运行时（读 manifest 校验数据文件、索引工具）。
    </description>

    <properties>
        <!-- protoc 输出的描述符集（含 import 的 cfg_options.proto），注解处理器据此生成表访问代码 -->
        <table.descriptor.set>${project.build.directory}/table-descriptors/config-tables.binpb</table.descriptor.set>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- 读 manifest.json；版本由 Spring Boot BOM 管理 -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- 只在编译期作为注解处理器使用，不进运行时、不传递 -->
            <groupId>com.game</groupId>
            <artifactId>xm-table-codegen</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <outputDescriptorFile>${table.descriptor.set}</outputDescriptorFile>
                    <outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <proc>full</proc>
                            <compilerArgs>
                                <arg>-Axm.table.descriptorSet=${table.descriptor.set}</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- 测试编译不再生成一份表访问代码（否则 test-classes 里会有一份同名副本） -->
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
