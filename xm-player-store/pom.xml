<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xm-player-store</artifactId>
    <name>xm-player-store</name>
    <description>账号 / 玩家持久化（MyBatis + Druid + MySQL）、玩家状态载体（protobuf）与玩家归属围栏</description>

    <dependencies>
        <dependency>
            <!-- 玩家状态载体 xm.storage.PlayerState（Java 版自有存储格式） -->
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <exclusions>
                <!-- 连接池用 Druid（选型表：同类 star 最高） -->
                <exclusion>
                    <groupId>com.zaxxer</groupId>
                    <artifactId>HikariCP</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 只用于测试：以 MySQL 兼容模式跑真实 SQL（归属夺权 / 释放 / 续约、建角上限的锁与事务），不连外部库。
             版本由 Spring Boot BOM 管理（见 docs/design/tech-stack.md） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <ignoreProjectDependencies>true</ignoreProjectDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
