<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-discovery</artifactId>
    <name>game-discovery</name>
    <description>Redis 上的节点号租约与游戏节点在线目录（Redisson）</description>

    <dependencies>
        <dependency>
            <!-- 与既有Druid starter同版本，仅供权威库物理连接策略；不向无SQL的调用方传播。 -->
            <groupId>com.alibaba</groupId><artifactId>druid</artifactId><version>${druid.version}</version><optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-common</artifactId>
        </dependency>
        <dependency>
            <!-- 热关停的规则条数 / 同步失败 / 短路次数指标 -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- 资产通道定位（location/SceneAssetLocator）读 SceneNodeInfo、产出 SceneAssetEndpoint。game-api 的 Dubbo 依赖是 optional，
             不会经这里带进不用 Dubbo 的进程 -->
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-api</artifactId>
        </dependency>
        <dependency>
            <!-- 部署命名空间 game.namespace 的 @ConfigurationProperties + @Validated（Bean Validation，实现为 Hibernate Validator；
                 版本由 Spring Boot BOM 管理）：非法值由 Spring Boot 自带的绑定校验失败报告拒启 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <!-- 真实TiDB夹具仅测试使用，沿现有BOM和缓存驱动；不向运行时调用方传播。 -->
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- 在线目录 / 推送的 Redis 值格式 game.discovery.* -->
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <ignoreProjectDependencies>true</ignoreProjectDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
