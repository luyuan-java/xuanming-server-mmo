<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>xm-gate</artifactId>
    <name>xm-gate</name>
    <description>客户端接入（Spring Boot + Netty）：握手验签、会话、按消息号路由到 login（Dubbo）或 scene（节点链路）、下行推送</description>

    <properties>
        <!-- @ConfigurationProperties 的 record 构造器绑定依赖形参名；父 POM 不是 spring-boot-starter-parent，需自己打开。 -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <!-- 只在 nacos profile 下生效（dubbo.registry.address=nacos://...）；local profile 注册中心为 N/A、Dubbo 直连 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-nacos-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-proto</artifactId>
        </dependency>
        <!-- tip 码枚举（com.game.table.*ErrorTip）与 MessageLimiter 表的消息类型；gate 只读 messagelimiter.pb 这一张表 -->
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-table</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-net</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>xm-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.game.gate.GateApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
