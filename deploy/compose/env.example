# deploy/compose 用到的环境变量（只列名字与用途，不写值；docs/porting/deploy-ci-spec.md §6.1–§6.2）。
#
#   cp deploy/compose/env.example deploy/compose/.env    # .env 不入库（.gitignore 已忽略）
#
# compose 自动读 compose 文件所在目录（项目目录）下的 .env；shell 里已导出的同名变量优先于 .env。
# 秘密的值用 openssl rand -hex 32 生成（64 个十六进制字符，满足各密钥 32 字节的下限），每个变量各自生成、互不相同。
# 必填项在 compose 里写成 ${VAR:?}：留空或不设都会让 compose 在启动前就失败（fail-closed）。可选项写成 ${VAR:-}。
# 这里的变量名与 tools/local/start-slice.sh、各进程 application.yaml 读的环境变量同名。

# ---------------------------------------------------------------- infra.yaml
# MySQL root 口令（必填）。mysql 容器初始化用；宿主上的集成测试（-Dgame.it.mysql）与 start-slice.sh 起的进程也读同名变量
GAME_MYSQL_PASSWORD=

# stack.yaml 需要明确的构建原件：GAME_IMAGE_TAG = GAME_BUILD_COMMIT 的前12位。
# GAME_BUILD_COMMIT=<git rev-parse HEAD>
# GAME_BUILD_CONTRACT=<contract/SOURCE.properties 的 mmorpg.commit>
# GAME_IMAGE_TAG=<12位提交>
# 路由世代：为该空库生成一次非零UUID并保存在本地.env；重启必须复用，不能自动替换已有世代。
# GAME_ROUTE_GENERATION=<UUID>
# GAME_INITIAL_ZONES=1

# MySQL 第一次初始化数据目录时预建哪个库（可选，只被 infra.yaml 的 MYSQL_DATABASE 读）。infra 是共用的、不属于任何部署，所以它是独立的变量，
# 不读部署命名空间 GAME_NAMESPACE。不设 = 预建缺省部署的库 game（game-team 的 JDBC URL 不带 createDatabaseIfNotExist，缺省部署冷启动靠它，
# deploy-ci-spec 坑 #16）；只给某一个部署用时设成它的部署命名空间 <ns>；写成空值（GAME_MYSQL_INIT_DATABASE=）= 什么库都不预建，各部署的库由
# 各自进程的 createDatabaseIfNotExist（game-login 先于 game-team 起，start-slice.sh 就是这个次序）或 DBA 建。
# GAME_MYSQL_INIT_DATABASE=game

# 发布到宿主 127.0.0.1 的端口（可选，缺省 3306 / 6379 / 9092 = 各进程 application.yaml 的缺省）。
# 开发机上已有本地 MySQL / Redis / Kafka 或基线 mmorpg 的 compose 占着这些端口时改开
# GAME_MYSQL_HOST_PORT=3306
# GAME_REDIS_HOST_PORT=6379
# GAME_KAFKA_HOST_PORT=9092

# ---------------------------------------------------------------- 整栈 stack.yaml（批次 7.1b 起；按进程最小授权，每个进程只拿自己用的）
# 部署命名空间（整栈必填；architecture.md §6.2）：Redis 键前缀 <ns>:、Kafka topic / 消费组 / client.id 前缀 <ns>-、MySQL 库名 <ns>（进程启动时
# 核对 DATABASE()，库名必须等于它）。合法值 [a-z][a-z0-9]{0,27}（1–28 个字符，<ns>_app 账号名因此不超过 MySQL 的 32 字符上限），且不是
# mysql / sys / public；空串、大写、首尾空白一律拒启。一个部署定下后不能改。它只表示进程租户：infra.yaml 不读它（预建库见上面的
# GAME_MYSQL_INIT_DATABASE）。stack.yaml 给每个 Java 服务写 GAME_NAMESPACE: ${GAME_NAMESPACE:?}，不给缺省值——共用中间件时漏设会让整套进程
# 静默落进缺省部署 game，所以缺省部署也显式写 GAME_NAMESPACE=game。全部进程与命令行工具（AuditFallbackReplay、assetopfix、PasswordAdmin）
# 必须同值：工具与服务进程同口径绑定（环境变量 GAME_NAMESPACE 或 -Dgame.namespace），把服务进程的这个值原样给工具即可。
# 本机切片不读 .env（.env 只有 compose 读）：要让切片进 t1，在起切片的 shell 里 GAME_NAMESPACE=t1 tools/local/start-slice.sh。
# 同一台主机起第二套整栈要换 compose 项目名（docker compose -p <项目名> …；stack.yaml 的草图写死 name: game-java，
# 并且 include 了 infra.yaml，换项目名得到的是另一套 infra——两套整栈要共用一套 infra 见 deploy-ci-spec §2.3 第 5 条）。
# 镜像命名空间 GAME_IMAGE_NAMESPACE（镜像仓库路径，如 game-java）又是另一回事，别填混（四种 namespace 的对照见 architecture.md §6.2）。
# GAME_NAMESPACE=game
# Dubbo 调用签名密钥（必填）：scene-manager、login、friend、chat、team、guild、trade、scene、gate、gateway、battle、match
# （match 批次 6.4：既是 gate / team 的提供方，又是 scene 战斗通道与 battle 控制面的调用方；缺失即拒启）
GAME_DUBBO_SECRET=
# gate 令牌密钥（必填）：gate、gateway、scene-manager；battle 可选（只用来检查与 GAME_BATTLE_TOKEN_SECRET 不相同）
# （scene-manager 批次 5.4：给跨 zone 传送与登录期重定向签票据，缺失即拒启——assign 也在它上面，漏给它连普通进游戏都会失败；三个进程原值逐字节相同）
GAME_GATE_TOKEN_SECRET=
# gate ↔ scene 链路密钥（必填）：gate、scene
GAME_NODE_LINK_SECRET=
# 开发登录口令（必填，game.login.mode 缺省 dev）：login；宿主上的 robot 也读它
GAME_LOGIN_DEV_PASSWORD=
# 帮会资产指令签名密钥（必填，去掉首尾空白后至少 32 字节）：guild、scene；robot guild-economy 场景也读它
GAME_ASSET_OP_SECRET_GUILD=
# battle 票据密钥（必填，至少 32 字节，且不得与 GAME_GATE_TOKEN_SECRET 相同）：battle（批次 6.2）
GAME_BATTLE_TOKEN_SECRET=
# 观战凭证密钥（必填，至少 32 字节，且不得与 GAME_GATE_TOKEN_SECRET、GAME_BATTLE_TOKEN_SECRET 相同）：match 签、gate 验（观战大厅档）
GAME_SPECTATE_TOKEN_SECRET=
# 观战大厅档开关（可选，缺省 true：满员转大厅档，battle 经 Redis 分片 pub/sub 发帧，需 Redis 7+）：match；false = 直连席满了回 16021
# GAME_MATCH_SPECTATE_RELAY_ENABLED=true

# 完整整栈新域：下列每个名字各自生成独立32字节随机值，调用双方由stack共享同名变量。
GAME_ASSET_OP_SECRET_MAIL=
GAME_ASSET_OP_SECRET_TRADE=
MAIL_PRODUCER_SECRET_RANK=
RANK_PRODUCER_SECRET_MATCH=
MMORPG_INTERNAL_SECRET_SCENE=
GAME_MALL_GATEWAY_SECRET=
GAME_MALL_PAYMENT_SECRET=
GAME_MALL_DELIVERY_SECRET=
GAME_MALL_ADMIN_SECRET=
# stack的robot/admin冒烟与GM停机都要求设置（独立随机值）；纯infra不读取。
GAME_ADMIN_TOKEN=
GAME_GM_ADMIN_SECRET=
# 运维接口令牌（可选）：data、trade、battle、match 的 /admin/** 与 dev 接口、robot；不设时这些接口一律回 503
# （match 的 dev 管理口 /admin/match/dev/*——读评分、活动开战——另外只在 GAME_RUN_MODE 为 dev / test 时开放，其余回 403）
# GAME_ADMIN_TOKEN=
# GM 停机签名密钥（可选）：gate、scene；不设时 GM 停机接口一律拒绝（tools/GmShutdown.java 用同名变量签名）
# GAME_GM_ADMIN_SECRET=

# 对局结果 topic 的代次（可选，缺省 1）：battle 往 <ns>-battle-result-g<代次>（缺省 game-battle-result-g<代次>）生产对局结果，match 从同一个 topic 消费后更新评分（批次 6.4）。
# 两个进程必须拿到同一个值——不一致时结果发进一个没人消费的 topic，评分静默不更新。topic 的分区数与预期不符（进程启动时会明说）时
# 换一个代次，不要去改已有的 topic。Kafka 地址沿用各进程 application.yaml 的 GAME_KAFKA_BOOTSTRAP_SERVERS（scene、data、battle、match 都读它）
# GAME_BATTLE_RESULT_TOPIC_GENERATION=1

# 运行档位（可选，缺省 dev，同 start-slice.sh）：GM 指令、trade 播种与 match 的 dev 管理口只在 dev 下打开。
# 对外演示必须改成 prod，并重新评估要发布哪些端口
# GAME_RUN_MODE=dev

# 全球匹配生产配置：所有match副本共用同一TiDB事务库，所有battle使用同一探测密钥。
# infra.yaml是单节点开发夹具；启用全球模式必须改用已有的至少3副本Kafka集群，
# 结果topic要求min.insync.replicas>=2且禁止不完整副本选主，不能用本夹具声明故障耐久。
# GLOBAL_MATCH_ENABLED=true
# PHYSICAL_REGION=1
# MATCH_PROBE_SECRET=
# KAFKA_TOPIC_REPLICATION_FACTOR=3
# GAME_KAFKA_BOOTSTRAP_SERVERS=broker-a:9092,broker-b:9092,broker-c:9092
# SPRING_DATASOURCE_URL=jdbc:mysql://global-tidb:4000/game?useSSL=true&characterEncoding=utf8
# GAME_MYSQL_USER=
# RANK_PRODUCER_SECRET_MATCH=
# GAME_RANK_RPC_HOST=rank
# GAME_RANK_RPC_PORT=20917
# GAME_BATTLE_CLIENT_ADVERTISE_HOST=
# GAME_BATTLE_ADVERTISE_PORT=12000

# ---------------------------------------------------------------- 只有 tools/local/start-slice.sh 读的拓扑开关（compose 不读，写进 .env 没有作用）
# 列在这里只为说明它们不是漏配的进程配置项：在启动切片的 shell 里临时给，例如 GAME_ZONES=2 tools/local/start-slice.sh。
#   GAME_SCENE_NODES（1 / 2，缺省 1）：=2 时区 1 多起一个场景节点 game-scene-2（链路 21001、资产通道 21101、管理端口 18114）。
#   GAME_ZONES（1 / 2，缺省 1；批次 6.5）：=2 时多起区 2 的 game-scene-z2（链路 21010、资产通道 21110、管理端口 18115）与
#     game-gate-z2（客户端 11010、管理端口 18123），其余进程两个区共用。区 2 在区服目录里的那一行由脚本经 game-data 的运维接口管
#     （用上面的 GAME_ADMIN_TOKEN），状态跟随这个开关：=2 时置 OPEN（库里没有就建），=1 时置维护。robot battle-cross-zone 要 =2 的切片。
# compose 整栈的双 zone 形态（覆盖文件 two-zones.yaml）随 stack.yaml（批次 7.1b）再做，届时两个区的 gate / scene 是各自的服务，不用这个开关。

# ---------------------------------------------------------------- 只有 nacos profile 的进程读（compose 与本机切片都走 local profile，写进 .env 没有作用）
# Nacos 地址（可选，缺省 127.0.0.1:8848；10 个进程的 application-nacos.yaml 拼成 nacos://${GAME_NACOS_ADDR}）。部署命名空间不自动派生
# Nacos namespace（缺省落在 public，与以前相同）：多个部署共用一个 Nacos 时，每个部署在这里带 ?namespace=<ID>（推荐，如
# GAME_NACOS_ADDR=127.0.0.1:8848?namespace=t1），或给 Dubbo 的配置项 dubbo.registry.parameters.namespace（只能经 -D 系统属性 / 命令行参数 /
# SPRING_APPLICATION_JSON 给），并先在 Nacos 建好命名空间 ID 恰好等于该值的 namespace（建议取 <ns>；控制台不填 ID 会生成 UUID，对不上）。
# 环境变量 DUBBO_REGISTRY_PARAMETERS_NAMESPACE 与方括号写法 parameters[namespace] Dubbo 3.3.6 都不认，会静默落进 public
# （game-chat 的 NacosRegistryNamespaceTest 钉住，architecture.md §6.2）。
# GAME_NACOS_ADDR=127.0.0.1:8848
