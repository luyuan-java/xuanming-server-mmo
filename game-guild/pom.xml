<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-guild</artifactId>
    <name>game-guild</name>
    <description>帮会服（Spring Boot + Dubbo 提供方，group guild）：建 / 查 / 退 / 解散 / 公告 / 任免 / 踢人 / 转让 / 申请审批 / 推送 220 / 排行；经济（捐献 / 升级 / 商店）、资产指令账本与跨进程投递、重投循环、内部查询、人工终结 CLI；七张表经 game-pbmysql 建表</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <!-- 只在 nacos profile 下生效（dubbo.registry.address=nacos://...）；默认配置注册中心为 N/A、走直连 URL -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-nacos-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-proto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-table</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-pbmysql</artifactId>
        </dependency>
        <!-- 只用已落盘账本的只读件（com.game.player.store.asset：读 game.player_state 并分类，与 scene 同一份判定代码；
             guild-economy-spec §4.9 / Q3a）。不要它的 MyBatis：PlayerStoreAutoConfiguration 在 GuildApplication 里排除，
             MyBatis starter 在这里排除（帮会不用 PlayerStore，带进来只会多一个没有 mapper 的 SqlSessionFactory） -->
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-player-store</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.mybatis.spring.boot</groupId>
                    <artifactId>mybatis-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 可观测性（architecture.md §11）：业务入口是 Dubbo；这里的 Tomcat 只挂 actuator 管理端点（health / prometheus） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 资产通道的跨进程集成测试起真 Dubbo 提供方与调用方：调用方鉴权过滤器与资产请求签名器只从环境变量读密钥，这里给仅测试用的假值
                 （不是任何环境的真密钥；先例 game-gateway/pom.xml、game-scene/pom.xml） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <GAME_DUBBO_SECRET>game-guild-unit-test-only</GAME_DUBBO_SECRET>
                        <GAME_ASSET_OP_SECRET_GUILD>game-guild-unit-test-only-asset-op-secret-0123456789</GAME_ASSET_OP_SECRET_GUILD>
                    </environmentVariables>
                </configuration>
                <executions>
                    <!-- 非缺省部署命名空间的用例（@Tag("namespace")）：另起一个 surefire 执行、新 fork 的 JVM 里把 game.namespace 钉成 nstest
                         （命名空间进程内定格、没有 reset，只能换 JVM 切换）。缺省执行 default-test 排除这一组（根 pom）。不显式配 skip，
                         -DskipTests 对两个执行都生效；-Dtest=X 时这里过滤成 0 条不失败。跑测试不要给 mvn 传 -Dgame.namespace（会覆盖两边的钉值）。 -->
                    <execution>
                        <id>namespace</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>namespace</groups>
                            <systemPropertyVariables>
                                <game.namespace>nstest</game.namespace>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <!-- 只编译本模块的表定义（import game-pbmysql 的选项定义）；不扫描全部项目依赖：game-proto 里 mmorpg 的
                         proto_option.proto 与 pbmysql 的选项在 MessageOptions 上同号，同一次编译会撞扩展号 -->
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <ignoreProjectDependencies>true</ignoreProjectDependencies>
                    <importDependencies>
                        <importDependency>
                            <groupId>com.google.protobuf</groupId>
                            <artifactId>protobuf-java</artifactId>
                            <version>${protobuf.version}</version>
                            <dependencyResolutionDepth>DIRECT</dependencyResolutionDepth>
                        </importDependency>
                        <importDependency>
                            <groupId>com.game</groupId>
                            <artifactId>game-pbmysql</artifactId>
                            <version>${project.version}</version>
                            <dependencyResolutionDepth>DIRECT</dependencyResolutionDepth>
                        </importDependency>
                    </importDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.game.guild.GuildApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
