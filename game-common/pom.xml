<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-common</artifactId>
    <name>game-common</name>
    <description>无框架公共件：雪花 ID、gate 令牌签名</description>

    <properties><protoc.spec>file:/__MMORPG_EXPLICIT_PROTOC_REQUIRED__</protoc.spec></properties>
    <dependencies>
        <dependency>
            <groupId>com.game</groupId>
            <artifactId>game-proto</artifactId>
        </dependency>
        <dependency>
            <!-- GM 签名停机的受理逻辑要记拒绝 / 受理日志 -->
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <!-- 热关停规则值的 JSON 解析（版本由 Spring Boot BOM 管理；各进程本来就带它） -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build><resources><resource><directory>src/main/resources</directory></resource><resource><directory>${project.build.directory}/generated-resources/sql-authority</directory><targetPath>META-INF/sql-authority</targetPath></resource></resources><plugins><plugin><groupId>io.github.ascopes</groupId><artifactId>protobuf-maven-plugin</artifactId><version>${protobuf-maven-plugin.version}</version>
 <executions><execution><id>default</id><goals><goal>generate</goal></goals><configuration>
  <!-- 全部服务共享同源SQL维护协议的生成类型；不为取协议类型加载player-store自动配置。 -->
  <protoc kind="url"><url>${protoc.spec}</url></protoc><javaEnabled>true</javaEnabled><kotlinEnabled>false</kotlinEnabled>
  <ignoreProjectDependencies>true</ignoreProjectDependencies><embedSourcesInClassOutputs>false</embedSourcesInClassOutputs>
  <sourceDirectories><sourceDirectory>${project.basedir}/../game-player-store/src/main/proto</sourceDirectory></sourceDirectories>
  <includes><include>game/storage/route_authority.proto</include></includes>
  <importPaths><importPath>${project.basedir}/../game-player-store/src/main/proto</importPath></importPaths>
  <outputDescriptorFile>${project.build.directory}/generated-resources/sql-authority/route-authority.desc</outputDescriptorFile>
  <outputDescriptorIncludeImports>true</outputDescriptorIncludeImports><outputDescriptorAttached>false</outputDescriptorAttached>
 </configuration></execution></executions></plugin></plugins></build>
</project>
