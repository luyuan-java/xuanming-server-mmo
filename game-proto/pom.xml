<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.game</groupId>
        <artifactId>xuanming-server-mmo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-proto</artifactId>
    <name>game-proto</name>
    <description>
        两版共享的协议契约：src/main/proto 由 tools/ContractSync.java 从 mmorpg 同步（派生物，不许手改），
        另附消息号 / 事件号注册表的运行时读取。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <!-- 只在编译期作为注解处理器使用，不进运行时、不传递（与 game-table-codegen 一致） -->
            <groupId>com.game</groupId>
            <artifactId>game-proto-codegen</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <!-- MessageIdRegistry 与 game-proto-codegen 共享这份 descriptor set；保留自定义 option。 -->
                    <outputDescriptorFile>${project.build.outputDirectory}/contract/contract.desc</outputDescriptorFile>
                    <outputDescriptorIncludeImports>true</outputDescriptorIncludeImports>
                    <outputDescriptorRetainOptions>true</outputDescriptorRetainOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <proc>full</proc>
                            <compilerArgs>
                                <arg>-Agame.proto.descriptorSet=${project.build.outputDirectory}/contract/contract.desc</arg>
                                <arg>-Agame.proto.messageIds=${project.basedir}/src/main/resources/contract/message_id.txt</arg>
                                <arg>-Agame.proto.eventIds=${project.basedir}/src/main/resources/contract/event_id.txt</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- 测试编译不再重跑协议代码生成，避免 test-classes 里出现重复生成类 -->
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
